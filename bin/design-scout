#!/bin/sh
# POSIX shim (macOS/Linux/Windows Git Bash -- Git Bash resolves THIS extensionless
# file, not design-scout.cmd, so it must work everywhere).
# Same pattern as bin/mb: never `exec A || exec B` (incident 2026-07-14), and
# never `python -m` (issue #16 -- `-m` puts the CWD on sys.path, where a
# `singularity/` directory shadows the installed package).
d="$(dirname "$0")"

for c in "$d/../.venv/bin/design-scout" "$d/../.venv/Scripts/design-scout.exe"; do
  if [ -x "$c" ]; then exec "$c" "$@"; fi
done

py="$d/../.venv/bin/python"
[ -x "$py" ] || py="$d/../.venv/Scripts/python.exe"
if [ ! -x "$py" ]; then
  echo "design-scout: no python interpreter found at $d/../.venv/{bin/python,Scripts/python.exe}" >&2
  exit 127
fi
exec "$py" "$d/_launch.py" design-scout singularity.scout.cli:main "$@"
