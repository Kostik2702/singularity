#!/bin/sh
# POSIX shim (macOS/Linux/Windows Git Bash -- Git Bash resolves THIS extensionless
# file, not mb.cmd, so it must work everywhere).
# NOTE: `exec A || exec B` is a false fallback: a failed exec exits a
# non-interactive shell with 127 before B can run (incident 2026-07-14,
# "mb POSIX shim silently dies in Git Bash"). Pick the target by checking the
# file instead, and fail LOUD if nothing is runnable.
d="$(dirname "$0")"

# 1. The generated console script. It sets sys.path[0] to its own directory,
#    so a `singularity/` folder in the CWD cannot shadow the package (issue
#    #16), and pip keeps it in sync with [project.scripts].
for c in "$d/../.venv/bin/mb" "$d/../.venv/Scripts/mb.exe"; do
  if [ -x "$c" ]; then exec "$c" "$@"; fi
done

# 2. Fallback: our launcher FILE. Never `-m` -- that is what put the CWD on
#    sys.path in the first place.
py="$d/../.venv/bin/python"
[ -x "$py" ] || py="$d/../.venv/Scripts/python.exe"
if [ ! -x "$py" ]; then
  echo "mb: no python interpreter found at $d/../.venv/{bin/python,Scripts/python.exe}" >&2
  exit 127
fi
exec "$py" "$d/_launch.py" mb singularity.cli:main "$@"
